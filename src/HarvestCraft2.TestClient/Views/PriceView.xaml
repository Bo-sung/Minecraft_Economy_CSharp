<UserControl x:Class="HarvestCraft2.TestClient.Views.PriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:HarvestCraft2.TestClient.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:PriceViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 컨트롤 패널 -->
        <Border Grid.Row="0" Background="LightGray" Padding="16" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="아이템:" VerticalAlignment="Center" 
                           FontWeight="Bold" Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1" x:Name="ItemComboBox" 
                          ItemsSource="{Binding AllPrices}"
                          SelectedValue="{Binding SelectedItemId}"
                          SelectedValuePath="ItemId"
                          DisplayMemberPath="ItemName"
                          MinWidth="300" Margin="0,0,16,0"/>

                <Button Grid.Column="2" Content="새로고침" 
                        Command="{Binding RefreshDataCommand}"
                        Padding="16,8"/>
            </Grid>
        </Border>

        <!-- 메인 차트 영역 -->
        <Border Grid.Row="1" Background="White" BorderBrush="Gray" 
                BorderThickness="1" Margin="8">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="실시간 가격 차트" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding SelectedItemName}" FontSize="14" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentPrice, StringFormat=C}" FontSize="16" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="LiveCharts 통합 진행 중..." FontSize="12" 
                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 하단 상태 바 -->
        <Border Grid.Row="2" Background="LightGray" BorderBrush="Gray" 
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="로딩..." VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>